<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="BuKo — un langage de programmation en développement, avec une syntaxe accessible en français et en anglais.">
  <title>BuKo — Le langage en construction</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#accueil" aria-label="BuKo accueil"><span class="mark">B</span> BuKo</a>
    <nav><a href="#fonctionnement">Le langage</a><a href="#exemple">Exemple</a><a href="#telecharger">Téléchargements</a><a href="https://github.com/">GitHub</a></nav>
  </header>
  <main>
    <section class="hero" id="accueil">
      <p class="eyebrow">UN PROJET EN CONSTRUCTION</p>
      <h1>Le code devrait être<br><span>plus simple à commencer.</span></h1>
      <p class="intro">BuKo est un langage de programmation expérimental et un projet d'IDE qui évolue étape par étape. Notre objectif : rendre la création de programmes plus accessible.</p>
      <div class="actions"><a class="button primary" href="#exemple">Découvrir BuKo</a><a class="button secondary" href="https://github.com/">Voir le projet sur GitHub</a></div>
      <div class="code-card"><div class="code-head"><span></span><span></span><span></span><small>bonjour.buko</small></div><pre><code>AF afficher "Bonjour depuis BuKo !".
AF afficher "Mon premier programme".</code></pre><div class="code-output">✓ Exemple de syntaxe — exécution à tester dans le moteur BuKo.</div></div>
    </section>
    <section class="section" id="fonctionnement"><p class="eyebrow">NOS OBJECTIFS</p><h2>Un projet, plusieurs outils</h2><div class="cards"><article><h3>Le langage BuKo</h3><p>Une syntaxe qui commence par des mots-clés comme <code>AF afficher</code>, avec une prise en charge progressive des fonctions du langage.</p></article><article><h3>BuKo Studio</h3><p>Un environnement de travail où l'on pourra écrire, exécuter, organiser et tester ses programmes.</p></article><article><h3>Création Web</h3><p>Le site officiel commence ici. Un éditeur web et des outils de création de sites sont des évolutions à développer, pas encore des fonctions disponibles.</p></article></div></section>
    <section class="section example" id="exemple"><p class="eyebrow">PREMIER EXEMPLE</p><h2>Un programme minimal</h2><p>Écris cet exemple dans un fichier nommé <code>bonjour.buko</code>.</p><pre><code>AF afficher "Bonjour !".
AF afficher "Bienvenue dans BuKo".</code></pre><p class="muted">Le moteur et l'interface mobile restent expérimentaux. Vérifie les résultats avant d'utiliser BuKo pour un projet important.</p></section>
    <section class="section download" id="telecharger"><p class="eyebrow">TÉLÉCHARGEMENTS</p><h2>Suivre le développement</h2><p>Le dépôt GitHub contiendra le code source, les versions et les instructions. Le fichier APK devra être compilé et testé avant sa distribution.</p><a class="button primary" href="https://github.com/">Ouvrir GitHub</a></section>
  </main>
  <footer><strong>BuKo</strong><span>Projet expérimental · Code et documentation en évolution</span></footer>
</body>
</html>
  :root{color-scheme:dark;--bg:#0b1020;--panel:#121a2e;--text:#edf2ff;--muted:#aab6d2;--blue:#70a5ff;--line:#283653}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 50% 0%,#17284a 0,transparent 50%),var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.6}.topbar{max-width:1080px;margin:auto;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{font-size:1.3rem;font-weight:800;color:var(--text);text-decoration:none;display:flex;align-items:center;gap:10px}.mark{display:grid;place-items:center;background:var(--blue);color:#081127;width:34px;height:34px;border-radius:11px}.topbar nav{display:flex;flex-wrap:wrap;gap:18px}.topbar nav a{color:var(--muted);text-decoration:none;font-size:.92rem}.topbar nav a:hover{color:var(--text)}main{max-width:1000px;margin:auto;padding:0 24px}.hero{text-align:center;padding:75px 0 65px}.eyebrow{color:var(--blue);font-size:.78rem;font-weight:800;letter-spacing:.15em}.hero h1{font-size:clamp(2.4rem,7vw,4.7rem);line-height:1.08;letter-spacing:-.055em;margin:18px 0}.hero h1 span{color:var(--blue)}.intro{max-width:660px;margin:0 auto;color:var(--muted);font-size:1.08rem}.actions{display:flex;justify-content:center;flex-wrap:wrap;gap:12px;margin:28px 0 42px}.button{display:inline-block;padding:11px 17px;border-radius:12px;text-decoration:none;font-weight:750}.primary{background:var(--blue);color:#071127}.secondary{border:1px solid var(--line);color:var(--text)}.code-card{max-width:650px;margin:auto;text-align:left;background:#080c17;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 25px 80px #0005}.code-head{display:flex;align-items:center;gap:7px;padding:14px;border-bottom:1px solid var(--line)}.code-head span{width:9px;height:9px;border-radius:50%;background:#60708d}.code-head small{margin-left:10px;color:var(--muted)}pre{white-space:pre-wrap;overflow-wrap:anywhere;margin:0;padding:24px;font-size:.95rem;color:#d9e6ff}.code-output{border-top:1px solid var(--line);padding:12px 20px;color:#a9d8bd;font-size:.82rem}.section{padding:55px 0;border-top:1px solid var(--line)}.section h2{font-size:clamp(1.8rem,4vw,2.6rem);line-height:1.2;margin:8px 0 20px;letter-spacing:-.03em}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:26px}.cards article{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px}.cards h3{margin-top:0}.cards p,.section>p:not(.eyebrow){color:var(--muted)}.cards code,.section code{color:#b8d2ff}.example pre{background:#080c17;border:1px solid var(--line);border-radius:16px;margin:20px 0}.muted{font-size:.9rem}.download{padding-bottom:70px}footer{border-top:1px solid var(--line);padding:25px 24px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);max-width:1000px;margin:auto;font-size:.88rem}footer strong{color:var(--text)}@media(max-width:650px){.topbar{align-items:flex-start;flex-direction:column}.topbar nav{gap:12px}.hero{padding-top:45px}.cards{grid-template-columns:1fr}.section{padding:40px 0}.actions{align-items:stretch;flex-direction:column}.button{width:100%}}
